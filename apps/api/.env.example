# SMTP2GO — booking confirmation emails
# Get your API key from https://smtp2go.com/clientarea/api
# Leave empty to disable email sending (bookings still work, no mails sent)
SMTP2GO_API_KEY=
BOOKING_CONFIRMATION_FROM=bookings@casa-baia-sant-anna.com

# Admin notification — separate email sent to the booking team on each new request
BOOKING_ADMIN_EMAIL=info@casa-baia-sant-anna.com
